{
  "rules": {
    "drivers": {
      ".read": "auth != null && (
        root.child('users').child(auth.uid).child('role').val() === 'admin'
      )",
      "$driverId": {
        ".write": "auth.uid === $driverId ||
          root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".read": "auth.uid === $driverId ||
          root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    }
  }
}
