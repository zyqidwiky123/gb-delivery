<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#CC000000"
    android:padding="12dp"
    android:elevation="8dp">

    <TextView
        android:id="@+id/tv_debug_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔧 ARO DRIVE DEBUG"
        android:textColor="#00FF00"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_gps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GPS: --"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tv_queue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Queue: 0"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_trip_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trip: IDLE"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_sync"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Last Sync: --"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_location_interval"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loc Interval: 5s"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

</LinearLayout>