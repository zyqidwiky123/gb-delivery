{
  "name": "aro-drive-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "aro-drive-vite",
    "aro-admin-vite",
    "functions",
    "packages/shared"
  ],
  "scripts": {
    "lint": "eslint . --ext .js,.jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md}\"",
    "format:write": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6"
  }
}
